<launch>
    <arg name="map_frame" default="map"/>
    <arg name="base_frame" default="camera_init"/>
    <arg name="odom_frame" default="aft_mapped"/>

    <!-- Set this to your 0F map. -->
    <arg name="map_file" default="$(find navigation_manager)/maps/LS_123_floor0.yaml"/>

    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />

    <node pkg="navigation_manager" type="hdl_killer.py" name="hdl_killer" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="inlier_fraction_thresh" value="0.90"/>
        <param name="matching_error_thresh" value="0.05"/>
    </node>

    <node pkg="navigation_manager" type="stair_climber.py" name="stair_climber" output="screen">
        <param name="map_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="half_height" value="2.14"/>
        <param name="full_height" value="4.28"/>
        <param name="platform_forward_duration" value="1.5"/>
        <param name="top_exit_duration" value="6.0"/>
    </node>

    <node pkg="navigation_manager" type="floor_manager.py" name="floor_manager" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="initial_floor" value="0"/>
        <param name="initial_target_floor" value="2"/>
        <param name="initial_target_key" value="office_goal"/>
    </node>
</launch>
