<launch>
    <!-- 全局坐标系参数 - 遵循用户习惯 -->
    <arg name="map_frame" default="map"/>
    <arg name="base_frame" default="camera_init"/> <!-- Odom Origin (Parent) -->
    <arg name="odom_frame" default="aft_mapped"/>  <!-- Robot Body (Child) -->

    <!-- 地图配置 -->
    <arg name="map_file" default="$(find navigation_manager)/maps/LS_floor2.yaml"/> 
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />  

    <!-- HDL 自动锁死与清理节点 -->
    <node pkg="navigation_manager" type="hdl_killer.py" name="hdl_killer" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="inlier_fraction_thresh" value="0.90"/>
        <param name="matching_error_thresh" value="0.05"/>
    </node>

    <!-- 楼层管理与导航逻辑 -->
    <node pkg="navigation_manager" type="floor_manager.py" name="floor_manager" output="screen">
        <param name="map_frame" value="$(arg map_frame)"/>
        <param name="base_frame" value="$(arg base_frame)"/>
        <param name="odom_frame" value="$(arg odom_frame)"/>
        <param name="initial_target_floor" value="3"/>
        <param name="initial_target_key" value="office_goal"/>
    </node>
</launch>